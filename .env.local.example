# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local (it's already in .gitignore).

# --- AI (required for real answers) ---
# Get a key at https://console.anthropic.com  (costs money per use; set a spending limit there!)
ANTHROPIC_API_KEY=
# Small, cheap model by default. Change only if you want to.
ANTHROPIC_MODEL=claude-haiku-5-5
# Max AI requests per day for the whole site (protects your wallet).
DAILY_REQUEST_LIMIT=200

# --- Database (optional at first; needed to save pre-checks, feedback, dashboard stats) ---
# Free Postgres from https://neon.tech -> copy the "pooled" connection string.
DATABASE_URL=

# --- Login with Clerk (optional at first; needed to lock the /staff dashboard) ---
# Free at https://clerk.com -> create an app -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Comma-separated emails allowed to see /staff with real data.
STAFF_EMAILS=you@example.com
